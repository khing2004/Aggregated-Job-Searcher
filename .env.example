# Copy this file to ".env" and fill in your keys. ".env" is git-ignored, never commit it.

# RapidAPI key (one key works for every RapidAPI API you subscribe to)
RAPIDAPI_KEY=your_rapidapi_key_here

# Monthly request caps the app enforces locally (set just below your plan's hard limit)
RAPIDAPI_CAP_JSEARCH=180        # JSearch free plan: 200 requests/month
RAPIDAPI_CAP_ACTIVEJOBS=9       # Active Jobs DB free plan: 25 requests / 250 jobs per month (25 jobs per call)
RAPIDAPI_CAP_HIREBASE=45        # HireBase free plan: 50 requests / 500 jobs per month

# Optional extra sources (leave blank to skip)
JOOBLE_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
